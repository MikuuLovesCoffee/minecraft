# Copy to /etc/craftmine/api.env on the server (never commit the real file).
PORT=3031
DATABASE_URL=postgres://craftmine:CHANGE_ME@127.0.0.1:5432/craftmine
# Long random string: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# Minecraft server folder (read-only access is enough)
MC_DIR=/opt/minecraft/server
MC_HOST=127.0.0.1
MC_PORT=25565
# Comma-separated Minecraft names that get the admin panel
ADMIN_PLAYERS=MikuuLovesCoffee
COOKIE_SECURE=true
